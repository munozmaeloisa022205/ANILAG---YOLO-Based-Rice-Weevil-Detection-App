[Unit]
Description=Anilag - Rice Weevil Detection and Control System
After=graphical.target
Wants=graphical.target

[Service]
Type=simple
User=pi
Group=pi
# The project directory and venv path must match your installation.
# Edit PROJECT_DIR below if Anilag is installed somewhere other than /home/pi/anilag.
Environment=PROJECT_DIR=/home/pi/anilag
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority
WorkingDirectory=/home/pi/anilag
ExecStart=/home/pi/anilag/scripts/anilag-autostart.sh
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target
