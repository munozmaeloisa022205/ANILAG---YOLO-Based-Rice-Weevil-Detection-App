# Camera Configuration
# Only USB webcams are supported (via OpenCV / V4L2).

# Dual Camera Mode
# Set to 'true' to enable dual USB camera support, 'false' for single camera
DUAL_CAMERA_MODE=false

# Left Camera Configuration
LEFT_CAMERA_ID=0

# Right Camera Configuration  
RIGHT_CAMERA_ID=1

# Camera Resolution
# Raspberry Pi 5 with 8GB RAM can handle higher resolutions
# For dual cameras, consider using 640x480 for optimal performance
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30

# Model Configuration
# models/sitophilus_oryzae_v2-3_best.pt is a YOLOv11n fine-tuned on a single class,
# "Sitophilus Oryzae". It is byte-identical to
# AI-MODEL/runs/detect/sitophilus_oryzae_v2-3/weights/best.pt.
# Training (157 epochs, imgsz 640): mAP50 0.958, mAP50-95 0.717, P 0.944, R 0.954.
#
# Do NOT point this at models/yolov11n.pt - that is the stock 80-class COCO model and
# has no rice weevil class (the app detects this and suppresses its detections).
MODEL_PATH=models/sitophilus_oryzae_v2-3_best.pt

# Matches AI-MODEL/runs/detect/sitophilus_oryzae_v2-3/args.yaml (iou: 0.7, max_det: 300).
CONFIDENCE_THRESHOLD=0.5
IOU_THRESHOLD=0.7
YOLO_MAX_DET=300

# Inference input size. The model was TRAINED at 640, so 640 reproduces the accuracy
# above. Dropping to 320 roughly quarters the compute but loses recall on small weevils;
# the app warns in the UI whenever this differs from MODEL_TRAINED_IMGSZ.
YOLO_IMGSZ=640
MODEL_TRAINED_IMGSZ=640

# Automatically load the NCNN export (<model>_ncnn_model/) when present.
# NCNN is roughly 5x faster than PyTorch on the Pi 5 ARM CPU. The input size is baked
# into the export, so it is only used when it matches YOLO_IMGSZ - otherwise the app
# warns and falls back to PyTorch. Re-export after changing YOLO_IMGSZ:
#   python -c "from ultralytics import YOLO; YOLO('models/sitophilus_oryzae_v2-3_best.pt').export(format='ncnn', imgsz=640)"
USE_NCNN=true

# Minimum milliseconds between detection cycles. Throttling keeps CPU headroom for the
# GUI, video recording and database writes. 200ms = 5 detection cycles/second.
DETECTION_INTERVAL_MS=200

# DS18B20 Temperature Sensor Configuration
# Enable 1-Wire: add 'dtoverlay=w1-gpio,gpiopin=4' to /boot/firmware/config.txt, reboot.
# Wiring: DQ -> GPIO4 (pin 7), VDD -> 3.3V, GND -> GND, 4.7k pull-up from DQ to 3.3V.
# Leave blank to auto-detect the 28-* device.
TEMP_SENSOR_DEVICE_ID=
# A DS18B20 conversion blocks up to 750ms, so it is polled on a background thread
# and the UI reads the cached value.
TEMP_POLL_INTERVAL=2.0
TEMP_STALE_AFTER=15.0
# Discard the 85.000C power-on-reset value (not a real measurement).
TEMP_REJECT_85C=true

# WS2813 LED Configuration
# rpi_ws281x does NOT work on the Raspberry Pi 5 (RP1 GPIO chip), so the strip is
# driven over hardware SPI: DI -> MOSI = GPIO10 (header pin 19), via a 3.3V->5V level
# shifter. Tie BI to GND on the first pixel only. Enable SPI in raspi-config first.
# 'auto' = SPI on Pi 5, rpi_ws281x on Pi 4 and older.
LED_USE_SPI=auto
LED_SPI_BUS=0
LED_SPI_DEVICE=0
LED_SPI_HZ=2400000
LED_COLOR_ORDER=GRB
LED_WHITE_BALANCE=255,255,255
# Only used by the rpi_ws281x fallback on Pi 4 and older.
LED_GPIO_PIN=18
LED_COUNT=60
LED_BRIGHTNESS=255

# Storage Configuration
# External SSD for Raspberry Pi 5 (KINGSTON A400 SSD 240GB recommended)
# Set to SSD mount path for better performance and reduced SD card wear
# Example: /mnt/ssd/anilag or /media/pi/KINGSTON/anilag
# For Raspberry Pi 5 with external SSD, use: /mnt/ssd/anilag
SCAN_STORAGE_PATH=/mnt/ssd/anilag/scans
DB_STORAGE_PATH=/mnt/ssd/anilag/database

# Logging Configuration
LOG_FILE=logs/detection_log.csv
# Sparse baseline log interval: one row per this many seconds regardless of the count, so
# a scan that finds little or nothing still produces evidence it ran.
LOG_INTERVAL_SECONDS=60
# Readings at or above HIGH_WEEVIL_THRESHOLD are logged this often at most, so a sustained
# high count does not flood the log/table.
SIGNIFICANT_LOG_INTERVAL_SECONDS=5

# Scan Protocol Configuration
# Each scan runs for this many seconds, then auto-stops and emails the zipped report
SCAN_DURATION_SECONDS=180

# Image Capture Configuration
# Images are only captured/stored when the weevil count reaches this threshold - that is,
# when it is significantly higher than an incidental one-or-two sighting.
HIGH_WEEVIL_THRESHOLD=5
# Minimum cooldown period in seconds between image captures
IMAGE_CAPTURE_COOLDOWN=30
# JPEG quality for the images stored as BLOBs in the database (higher = larger rows)
IMAGE_JPEG_QUALITY=85

# Email Notification Configuration
EMAIL_ENABLED=true
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SENDER=your_email@gmail.com
# IMPORTANT: Gmail rejects normal account passwords over SMTP (error 535 5.7.8).
# Generate a 16-character App Password for your_email@gmail.com at
# https://myaccount.google.com/apppasswords (2-Step Verification must be ON) and paste it here.
EMAIL_PASSWORD=your_16_char_app_password
# Comma-separated list is supported
EMAIL_RECIPIENT=recipient_email@gmail.com
# Skip attachments larger than this (Gmail's hard limit is 25 MB)
EMAIL_MAX_ATTACHMENT_MB=24
